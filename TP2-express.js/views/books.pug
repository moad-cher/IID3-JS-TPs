extends layout

block content
  .max-w-3xl.mx-auto.bg-white.p-8.rounded.shadow
    h2.text-2xl.font-bold.mb-4 Books
    p.text-gray-700.mb-4 Here are some books you can browse.
    ul.space-y-4
      each book in books
        li.border.p-4.rounded.flex.justify-between.items-center
          div
            h3.font-semibold= book.title
            p.text-sm.text-gray-600= book.author
    a(href="/logout" class="inline-block mt-6 px-4 py-2 bg-red-500 text-white rounded") Logout
