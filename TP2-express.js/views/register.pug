extends layout

block content
  .max-w-md.mx-auto.bg-white.p-8.rounded.shadow
    h2.text-xl.font-bold.mb-4 Register
    if errors
      each err in errors
        .mb-2.p-2.bg-red-100.text-red-800.rounded= err.msg
    form(action="/register" method="post" class="space-y-4")
      label.block
        span.text-sm Name
        input(type="text" name="name" value=(typeof name !== 'undefined' ? name : '') class="mt-1 block w-full border-gray-300 rounded p-2")
      label.block
        span.text-sm Email
        input(type="email" name="email" value=(typeof email !== 'undefined' ? email : '') class="mt-1 block w-full border-gray-300 rounded p-2")
      label.block
        span.text-sm Password
        input(type="password" name="password" class="mt-1 block w-full border-gray-300 rounded p-2")
      label.block
        span.text-sm Confirm Password
        input(type="password" name="password2" class="mt-1 block w-full border-gray-300 rounded p-2")
      button(type="submit" class="w-full py-2 bg-green-600 text-white rounded") Register
      p.text-sm.text-gray-600.mt-2 Already registered? 
        a(href="/login" class="text-blue-600") Login
