extends layout

block content
  .max-w-xl.mx-auto.bg-white.p-8.rounded.shadow
    h1.text-2xl.font-bold.mb-2 #{title}
    p.text-gray-700.mb-4 #{message}
    .flex.space-x-4
      a(href="/register" class="px-4 py-2 bg-green-500 text-white rounded") Register
      a(href="/login" class="px-4 py-2 bg-blue-500 text-white rounded") Login
